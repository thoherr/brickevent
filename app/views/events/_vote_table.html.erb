<% if total_vote_count == 0 %>
  <h4><%= t('no_votes') %></h4>
<% else %>
  <p>
    <%= t('number_of_votes_and_voters', size: total_vote_count, count: voters[:count]) %>
    <% if voters[:count] > 1 %>
      <br/>
      <%= t('votes_per_voter',
            min: voters[:min],
            max: voters[:max],
            average: number_with_precision(voters[:average], precision: 1),
            median: number_with_precision(voters[:median], precision: 1, strip_insignificant_zeros: true)) %>
    <% end %>
  </p>
  <table class="VotingTable FrontendTable">
    <tr>
      <th><%= t('heading_votes') %></th>
      <th><%= t('table_position') %></th>
      <th><%= t('heading_moc') %></th>
      <th><%= t('heading_name') %></th>
      <th><%= t('heading_id') %></th>
    </tr>
    <% top_voted_exhibits.each do |exhibit| %>
      <% number_of_votes = votes_by_exhibit[exhibit.id] %>
      <tr>
        <td>
          <progress max=<%= max_votes %> value=<%= number_of_votes %>></progress>
          <%= number_of_votes %></td>
        <td><%= exhibit.platform_position %></td>
        <td><%= exhibit.name %></td>
        <td><%= exhibit.user_name %></td>
        <td><%= exhibit.id %></td>
      </tr>
    <% end %>
  </table>
<% end %>
